---
import Nav from "../components/Nav.astro";
import ResidenceCard from "../components/ResidenceCard.astro";
import { getShortlistIds, listShortlistedResidences } from "../lib/db";
import "../styles.css";

const user = Astro.locals.user;
const results = user ? listShortlistedResidences(user.id) : [];
const shortlistIds = user ? getShortlistIds(user.id) : new Set<number>();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your shortlist — ANU Residence Explorer</title>
  </head>
  <body>
    <Nav />
    <main class="wide">
      <h1>Your shortlist</h1>
      {
        !user ? (
          <p>
            <a href="/login/?returnTo=/shortlist/">Log in</a> or <a href="/signup/?returnTo=/shortlist/">sign up</a> to
            save and view your shortlisted residences.
          </p>
        ) : (
          <>
            <p>
              Residences you've saved while browsing. This list is tied to your account, so it's still here next
              time you log in — even from a different device.
            </p>
            {
              results.length === 0 ? (
                <p class="no-results">
                  Nothing saved yet. Head to <a href="/search/">search</a> and use "Save to shortlist" on any
                  residence.
                </p>
              ) : (
                <ul class="residence-grid">
                  {results.map((r) => (
                    <ResidenceCard residence={r} shortlisted={shortlistIds.has(r.id)} redirectTo="/shortlist/" loggedIn />
                  ))}
                </ul>
              )
            }
          </>
        )
      }
    </main>
  </body>
</html>
