---
import Map from "../components/Map.astro";
import Nav from "../components/Nav.astro";
import ResidenceCard from "../components/ResidenceCard.astro";
import { getShortlistIds, listAllResidences, listShuttleStops, withResidenceStats } from "../lib/db";
import "../styles.css";

const residences = withResidenceStats(listAllResidences());
const shuttleStops = listShuttleStops();
const user = Astro.locals.user;
const shortlistIds = user ? getShortlistIds(user.id) : new Set<number>();
const redirectTo = "/";

const mapResidences = residences
  .filter((r) => r.latitude != null && r.longitude != null)
  .map((r) => ({ lat: r.latitude as number, lon: r.longitude as number, name: r.name, slug: r.slug }));
const mapShuttle = shuttleStops.map((s) => ({ lat: s.latitude, lon: s.longitude, name: s.name, note: s.note }));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Residence Explorer</title>
  </head>
  <body>
    <Nav />
    <main class="wide">
      <div class="hero-banner">
        <img
          src="https://imagedepot.anu.edu.au/isfs/banner/our-residence-banner.jpg"
          alt="Students walking on ANU campus outside student accommodation"
          width="1600"
          height="700"
        />
        <div class="hero-banner-overlay">
          <h1>ANU Residence Explorer</h1>
          <p>
            All {residences.length} of ANU's undergraduate and postgraduate residences, mapped, searchable and
            side by side — built on top of ANU's own public residences listing.
          </p>
        </div>
      </div>

      <section class="quick-start" aria-labelledby="quick-start-heading">
        <h2 id="quick-start-heading">Quick start — jump to a shortlist</h2>
        <p>
          Not sure where to look first? Pick whichever matters most to you, or answer a few questions for a
          ranking built around your own preferences instead.
        </p>
        <ul class="quick-start-grid">
          <li>
            <a class="quick-start-card" href="/search/?type=undergrad&sort=price_asc">
              <span class="quick-start-card-title">Undergrad, cheapest first</span>
              <span class="quick-start-card-desc">Undergraduate-eligible halls, lowest published rate first.</span>
            </a>
          </li>
          <li>
            <a class="quick-start-card" href="/search/?type=postgrad&sort=price_asc">
              <span class="quick-start-card-title">Postgrad, cheapest first</span>
              <span class="quick-start-card-desc">Postgraduate-eligible halls, lowest published rate first.</span>
            </a>
          </li>
          <li>
            <a class="quick-start-card" href="/search/?catering=catered&sort=rating_desc">
              <span class="quick-start-card-title">Catered, top rated</span>
              <span class="quick-start-card-desc">Fully catered halls, highest reviewer rating first.</span>
            </a>
          </li>
          <li>
            <a class="quick-start-card" href="/search/?maxDistance=1000&sort=distance_asc">
              <span class="quick-start-card-title">Close to the shuttle</span>
              <span class="quick-start-card-desc">Within 1&nbsp;km of an ANU Civic Loop stop, nearest first.</span>
            </a>
          </li>
          <li>
            <a class="quick-start-card quick-start-card-featured" href="/hall-match/">
              <span class="quick-start-card-title">Answer a few questions instead</span>
              <span class="quick-start-card-desc"
                >Get every hall ranked against your budget, catering and social preferences.</span
              >
            </a>
          </li>
        </ul>
      </section>

      <div class="cta-bar">
        <div>
          <h2>Compare all {residences.length} residences in one place</h2>
          <p>Filter by resident type, catering and price, then jump straight to the real ANU application page.</p>
        </div>
        <a class="btn-primary" href="/search/">Search &amp; filter</a>
      </div>

      <p>
        ANU's own <a href="https://study.anu.edu.au/accommodation/our-residences">residences listing</a> splits
        {residences.length} halls, lodges and colleges across separate pages with no way to compare them side by side,
        and no sense of where any of them actually sit in Canberra. This map plots every residence together with the
        <a href="https://sustainability.anu.edu.au/news/anu-civic-loop-bus-route-update-17-august-2026"
          >ANU Civic Loop shuttle route</a
        > (dashed red) and nearby bus stops, supermarkets and cafes, pulled from OpenStreetMap.
      </p>
      <Map id="overview-map" center={[-35.2778, 149.1185]} zoom={15} residences={mapResidences} shuttle={mapShuttle} />

      <h2>{residences.length} residences</h2>
      <ul class="residence-grid">
        {residences.map((r) => (
          <ResidenceCard residence={r} shortlisted={shortlistIds.has(r.id)} redirectTo={redirectTo} loggedIn={!!user} />
        ))}
      </ul>
    </main>
  </body>
</html>
