---
import Nav from "../components/Nav.astro";
import { safeRedirect } from "../lib/http";
import "../styles.css";

const returnTo = safeRedirect(Astro.url.searchParams.get("returnTo"), "/");
if (Astro.locals.user) {
  return Astro.redirect(returnTo, 303);
}
const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign up — ANU Residence Explorer</title>
  </head>
  <body>
    <Nav />
    <main>
      <h1>Sign up</h1>
      <p>
        Create an account for ANU Residence Explorer to save a shortlist, get hall matches, flag room interest and
        write reviews. This account is native to this app — it's not connected to ANU's real StarRez housing
        portal or any ANU login.
      </p>
      {error && <p class="auth-error">{error}</p>}
      <form method="post" action="/api/auth/signup" class="filters auth-form">
        <input type="hidden" name="returnTo" value={returnTo} />
        <div class="filters-row">
          <label for="username">
            Username
            <input id="username" name="username" type="text" autocomplete="username" minlength="3" required />
          </label>
          <label for="password">
            Password
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
          </label>
        </div>
        <div class="filters-actions">
          <button type="submit">Sign up</button>
        </div>
      </form>
      <p class="auth-switch">
        Already have an account? <a href={`/login/?returnTo=${encodeURIComponent(returnTo)}`}>Log in</a>.
      </p>
    </main>
  </body>
</html>
