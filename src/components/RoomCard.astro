---
import type { RoomSearchResult } from "../lib/db";

interface Props {
  room: RoomSearchResult;
  shortlisted: boolean;
  redirectTo: string;
  loggedIn: boolean;
}

const { room: r, shortlisted, redirectTo, loggedIn } = Astro.props;

const residentLabel =
  r.residentUndergrad && r.residentPostgrad
    ? "Undergrad & postgrad"
    : r.residentUndergrad
      ? "Undergrad"
      : r.residentPostgrad
        ? "Postgrad"
        : "Resident type unknown";

const cateringLabel = { self_catered: "Self-catered", catered: "Catered", flexi_catered: "Flexi-catered" }[
  r.cateringType
];

const ratingLabel =
  r.reviewCount > 0
    ? `★ ${r.avgRating?.toFixed(1)} (${r.reviewCount} ${r.reviewCount === 1 ? "review" : "reviews"})`
    : "No reviews yet";
const distanceLabel = r.nearestStopMeters != null ? `${r.nearestStopMeters} m to nearest shuttle stop` : undefined;
---

<li class="room-card">
  {r.imageUrl && (
    <a href={`/residences/${r.residenceSlug}/`} class="card-image-link">
      <img src={r.imageUrl} alt={`${r.residenceName} building exterior`} loading="lazy" width="920" height="518" />
    </a>
  )}
  <p class="rate-bar">
    {r.weeklyTariff != null ? <><strong>${r.weeklyTariff}</strong>/wk</> : "Not yet published (tbc)"}
  </p>
  <div class="card-body">
    <h2>
      {r.roomName}
      <span class="room-card-hall">
        in <a href={`/residences/${r.residenceSlug}/`}>{r.residenceName}</a>
      </span>
    </h2>
    <p class="card-subtitle">
      {cateringLabel} &middot; {residentLabel}
    </p>
    <p class="card-meta">
      {ratingLabel}
      {distanceLabel && " · "}
      {distanceLabel}
    </p>
    <div class="card-actions">
      {
        r.applyUrl && (
          <a class="btn-primary" href={r.applyUrl} target="_blank" rel="noopener noreferrer">
            Apply now
          </a>
        )
      }
      {
        loggedIn ? (
          <form method="post" action={`/api/shortlist/${shortlisted ? "remove" : "add"}`}>
            <input type="hidden" name="residenceId" value={r.residenceId} />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="link-button">
              {shortlisted ? "Remove from shortlist" : "Save to shortlist"}
            </button>
          </form>
        ) : (
          <a class="link-button" href={`/login/?returnTo=${encodeURIComponent(redirectTo)}`}>
            Log in to save
          </a>
        )
      }
      <label class="compare-checkbox-label">
        <input type="checkbox" class="compare-checkbox" name="rooms" value={r.roomId} form="compare-form" />
        Add to compare
      </label>
    </div>
  </div>
</li>
