---
interface ResidenceMarker {
  lat: number;
  lon: number;
  name: string;
  slug: string;
}
interface PlaceMarker {
  lat: number;
  lon: number;
  name: string | null;
  category: string;
}
interface ShuttleMarker {
  lat: number;
  lon: number;
  name: string;
  note: string | null;
}
interface Props {
  id: string;
  center: [number, number];
  zoom: number;
  residences?: ResidenceMarker[];
  places?: PlaceMarker[];
  shuttle?: ShuttleMarker[];
  small?: boolean;
}

const { id, center, zoom, residences = [], places = [], shuttle = [], small = false } = Astro.props;
---

<div class="map-wrapper">
  <div
    id={id}
    class={`map-container${small ? " small" : ""}`}
    data-initialized="0"
    data-center={JSON.stringify(center)}
    data-zoom={zoom}
    data-residences={JSON.stringify(residences)}
    data-places={JSON.stringify(places)}
    data-shuttle={JSON.stringify(shuttle)}
  >
  </div>
  <button type="button" class="map-refresh-btn" data-map-refresh={id}>
    ↻ Refresh map
  </button>
</div>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import markerIcon from "leaflet/dist/images/marker-icon.png?url";
  import markerIcon2x from "leaflet/dist/images/marker-icon-2x.png?url";
  import markerShadow from "leaflet/dist/images/marker-shadow.png?url";

  // Leaflet's default pin icon locates its own image files by reading its
  // CSS file's URL and resolving relative to that — a trick that only works
  // when leaflet.css is served from the same place as the leaflet package
  // itself. Vite bundles the CSS elsewhere, so that lookup 404s and the
  // browser shows a broken-image placeholder instead of the pin. Importing
  // the images directly lets Vite resolve their real, bundled URLs instead.
  // The `?url` suffix matters: without it, Astro's production build routes
  // these .png imports through its own image pipeline, which returns an
  // {src, width, height, format} metadata object instead of a plain URL
  // string — Leaflet then builds `<img src="[object Object]">` and the icon
  // 404s again. `?url` forces Vite's plain-string resolution in every mode.
  delete (L.Icon.Default.prototype as { _getIconUrl?: unknown })._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconUrl: markerIcon,
    iconRetinaUrl: markerIcon2x,
    shadowUrl: markerShadow,
  });

  const CATEGORY_LABEL: Record<string, string> = {
    bus_stop: "Bus stop",
    tram_stop: "Light rail stop",
    supermarket: "Supermarket",
    cafe: "Cafe",
  };
  const CATEGORY_COLOR: Record<string, string> = {
    bus_stop: "#2563eb",
    tram_stop: "#7c3aed",
    supermarket: "#059669",
    cafe: "#b45309",
  };

  interface ResidenceMarker {
    lat: number;
    lon: number;
    name: string;
    slug: string;
  }
  interface PlaceMarker {
    lat: number;
    lon: number;
    name: string | null;
    category: string;
  }
  interface ShuttleMarker {
    lat: number;
    lon: number;
    name: string;
    note: string | null;
  }

  function init(el: HTMLElement) {
    el.dataset.initialized = "1";
    const center = JSON.parse(el.dataset.center || "[-35.28,149.12]") as [number, number];
    const zoom = Number(el.dataset.zoom || "15");
    const map = L.map(el, { scrollWheelZoom: false }).setView(center, zoom);
    // Not tile.openstreetmap.org directly: OSM's own tile usage policy
    // requires a custom User-Agent identifying the app, which a
    // browser-issued tile request can never send. Not a third-party CDN
    // either — CARTO's free anonymous basemap tier (tried first) turned out
    // to require a registered API key after all, watermarking every tile
    // "API KEY REQUIRED" instead of serving it. /api/tiles proxies through
    // this app's own server, which can set that header, so this is this
    // app's origin the whole way and isn't subject to either restriction.
    const tileLayer = L.tileLayer("/api/tiles/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    const residences = JSON.parse(el.dataset.residences || "[]") as ResidenceMarker[];
    for (const r of residences) {
      L.marker([r.lat, r.lon])
        .addTo(map)
        .bindPopup(`<a href="/residences/${r.slug}/">${r.name}</a>`);
    }

    const places = JSON.parse(el.dataset.places || "[]") as PlaceMarker[];
    for (const p of places) {
      const label = CATEGORY_LABEL[p.category] || p.category;
      L.circleMarker([p.lat, p.lon], {
        radius: 6,
        color: CATEGORY_COLOR[p.category] || "#555",
        fillOpacity: 0.8,
      })
        .addTo(map)
        .bindPopup(`${p.name || label} (${label})`);
    }

    const shuttle = JSON.parse(el.dataset.shuttle || "[]") as ShuttleMarker[];
    if (shuttle.length > 0) {
      L.polyline(
        shuttle.map((s): [number, number] => [s.lat, s.lon]),
        { color: "#dc2626", weight: 3, dashArray: "6 4" },
      ).addTo(map);
      for (const s of shuttle) {
        L.circleMarker([s.lat, s.lon], { radius: 5, color: "#dc2626", fillColor: "#dc2626", fillOpacity: 1 })
          .addTo(map)
          .bindPopup(`${s.name}${s.note ? ` — ${s.note}` : ""} (ANU Civic Loop)`);
      }
    }

    // Leaflet sizes its tile grid once, from the container's dimensions at
    // the moment L.map() runs. It has no way to notice a later resize on its
    // own, so without this a map that loads correctly still shows grey/cut-off
    // tiles after a window resize, an orientation change, or any layout shift
    // that happens after this script starts (webfonts, the flex/grid reflow
    // around it). Re-measuring on every observed size change keeps it correct
    // on every page it appears on, at every viewport width.
    if (typeof ResizeObserver !== "undefined") {
      const resizeObserver = new ResizeObserver(() => map.invalidateSize());
      resizeObserver.observe(el);
    } else {
      window.addEventListener("resize", () => map.invalidateSize());
    }
    requestAnimationFrame(() => map.invalidateSize());

    // Any tile CDN occasionally drops a request or serves a transient
    // error, leaving a permanently grey/blank tile that a resize
    // doesn't fix (invalidateSize() only re-measures the container; it doesn't
    // retry a tile that already failed). redraw() re-requests every tile
    // currently in view, which is the actual fix for that case.
    const refreshBtn = el.parentElement?.querySelector<HTMLButtonElement>(`[data-map-refresh="${el.id}"]`);
    refreshBtn?.addEventListener("click", () => {
      tileLayer.redraw();
      map.invalidateSize();
    });
  }

  document.querySelectorAll<HTMLElement>('.map-container[data-initialized="0"]').forEach(init);
</script>
